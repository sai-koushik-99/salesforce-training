# ============================================================
# Salesforce DX — Placement Management System
# Chapter 12: From Developer Org to Production
# ============================================================

# Salesforce CLI local state (machine-specific, never commit)
.sfdx/
.sf/
.localdevserver/

# Source tracking state
**/localSourceTracking/

# Lock files generated by CLI
*.lock.json

# Node / LWC tooling
node_modules/
npm-debug.log
yarn-error.log

# LWC config files (IDE-generated, not deployment metadata)
**/jsconfig.json
**/.eslintrc.json

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE and editor files
.vscode/settings.json
*.swp
*.swo
*~

# SECURITY — Never commit credentials, tokens, or keys
.env
.env.*
*.pem
*.key
auth-token.json

# Scratch org config
config/project-scratch-def.json

# Temporary and log files
*.log
*.tmp
*.bak
deploy-output.txt
retrieve-output.txt
