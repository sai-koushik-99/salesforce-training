<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    FILE: placementHome.js-meta.xml
    PURPOSE: Metadata configuration for the placementHome LWC component.
    Tells Salesforce: API version, App Builder visibility, and allowed page types.
-->
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- 
        apiVersion: Salesforce API version this component targets.
        59.0 = Spring '23. Match this to your org's current API version.
    -->
    <apiVersion>59.0</apiVersion>

    <!-- 
        isExposed: 
        true  → Visible in Lightning App Builder palette (admins can drag & drop it).
        false → Hidden from App Builder, usable only as a child component in other LWCs.
    -->
    <isExposed>true</isExposed>

    <!-- 
        targets: Defines which Lightning page types this component 
        appears on in the App Builder component palette.
    -->
    <targets>

        <!-- Allows adding to custom Lightning App Pages -->
        <target>lightning__AppPage</target>

        <!-- Allows adding to the Salesforce default Home page -->
        <target>lightning__HomePage</target>

        <!-- Allows adding to any Object Record Detail page -->
        <target>lightning__RecordPage</target>

    </targets>

</LightningComponentBundle>
