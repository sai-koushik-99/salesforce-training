<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    FILE    : welcomeMessage.js-meta.xml
    PURPOSE : Metadata configuration for the welcomeMessage LWC component.
    DEFINES : API version, App Builder visibility, allowed page targets.
-->
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- 
        apiVersion: Salesforce release version this component targets.
        59.0 = Spring '23. Match with your org's current API version.
    -->
    <apiVersion>59.0</apiVersion>

    <!-- 
        isExposed:
        true  → Visible in Lightning App Builder drag-and-drop palette.
        false → Hidden from App Builder, used only as a child component.
    -->
    <isExposed>true</isExposed>

    <!-- 
        targets: Defines which Salesforce page types this component 
        can be placed on via Lightning App Builder.
    -->
    <targets>
        <!-- Custom Lightning App Pages -->
        <target>lightning__AppPage</target>

        <!-- Salesforce default Home page -->
        <target>lightning__HomePage</target>

        <!-- Any Object Record Detail page -->
        <target>lightning__RecordPage</target>
    </targets>

</LightningComponentBundle>
